# Host-specific entries (bastions, client boxes) go in ~/.ssh/config.d/*,
# which is not in this repo. Include must come before any Host block.
Include ~/.ssh/config.d/*

Host *
	# Keys live in 1Password; approve each use with Touch ID.
	IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
	ServerAliveInterval 60
	ServerAliveCountMax 3
	# Connection reuse: fast repeat ssh/scp/ansible to the same host
	ControlMaster auto
	ControlPath ~/.ssh/cm-%C
	ControlPersist 10m
	HashKnownHosts yes
	StrictHostKeyChecking accept-new
