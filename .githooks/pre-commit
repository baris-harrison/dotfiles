#!/bin/bash
# Block commits containing secrets or employer-identifying data.
# Enabled by install.sh (core.hooksPath = .githooks).
# Bypass for a false positive: add `gitleaks:allow` to the line, or
# `git commit --no-verify` if you're sure.
set -euo pipefail

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks not installed (brew install gitleaks); refusing to commit" >&2
  exit 1
fi

repo_root="$(git rev-parse --show-toplevel)"
exec gitleaks git --pre-commit --staged --redact --no-banner \
  --config "$repo_root/.gitleaks.toml" "$repo_root"
